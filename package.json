{
  "name": "agent-team-up",
  "version": "0.6.0",
  "description": "One MCP server for a team of coding agents across apps and subscriptions: goals, tasks, handoffs, questions and a live board.",
  "keywords": [
    "mcp",
    "mcp-server",
    "mcp-apps",
    "agents",
    "claude-code",
    "codex",
    "antigravity",
    "multi-agent"
  ],
  "license": "MIT",
  "author": "firstprateek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firstprateek/agent-team-up.git"
  },
  "type": "module",
  "bin": {
    "agent-team-up": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/board.html src/wiki.html dist/",
    "typecheck": "tsc -p .",
    "test": "node --test --test-concurrency=1 'test/*.test.ts'",
    "check": "npm run typecheck && npm test",
    "start": "node src/cli.ts serve",
    "prepublishOnly": "npm run check && npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
